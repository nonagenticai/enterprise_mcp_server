# ==============================================================================
# Enterprise MCP Server - Secrets Configuration
# ==============================================================================
# IMPORTANT: This file contains ONLY secrets (passwords, keys, tokens)
# All other configuration belongs in docker-compose.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD_ENTERPRISE_MCP=CHANGE_ME_SECURE_PASSWORD

# ------------------------------------------------------------------------------
# Keycloak Authentication (OAuth2 Standard)
# ------------------------------------------------------------------------------
SERVICE_CLIENT_ID=enterprise-mcp-server
SERVICE_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET
# Example values only - override per deployment with your own Keycloak host/realm.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master

# ------------------------------------------------------------------------------
# Service Endpoints (non-secret; defaults in docker-compose.yml suit a local clone)
# ------------------------------------------------------------------------------
# Host/IP the container should use to reach services running on the Docker host.
INTERNAL_SERVICES_IP=host.docker.internal
# Postgres host - defaults to the `db` service in docker-compose.override.yml.
POSTGRES_HOST=db
# Connection-pooler host/port. Point at your pgbouncer when you run one.
PGBOUNCER_HOST=db
PGBOUNCER_PORT=5432
# Query string appended to DATABASE_URL; set to `sslmode=disable` for a plain local DB.
DATABASE_SSL_PARAMS=sslmode=disable
# Secrets service base URL.
SECRETS_URL=http://localhost:8543

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

# ------------------------------------------------------------------------------
# Admin User Credentials
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=CHANGE_ME_PASSWORD
DEFAULT_ADMIN_PASSWORD_HASH=CHANGE_ME_PASSWORD_HASH

# ------------------------------------------------------------------------------
# External API Keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=CHANGE_ME_API_KEY
